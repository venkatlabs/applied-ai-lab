# Demo mode works without keys. Use live only after server-side keys are configured.
NEXT_PUBLIC_APP_MODE=demo

# AI synthesis (server only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Optional separate model for the web-search evidence brief
OPENAI_WEB_MODEL=
# Optional dated prices so reports show an estimated cost, e.g.
# {"gpt-5.6-terra":{"asOf":"2026-09-30","inputPerMillion":0,"cachedPerMillion":0,"outputPerMillion":0,"searchPerCall":0}}
RESEARCH_PRICING_JSON=

# Paid-research guard: max reserved live research attempts per UTC day across the app (default 15).
# Same-day reports for a ticker are reused and don't count. Research pauses if the
# archive database is unavailable. Failed attempts retain their reservation.
RESEARCH_DAILY_CAP=15
# AI-free quick checks (watchlist, holdings, screen): new companies per UTC day (default 60).
# Re-checking the same company the same day is cached and free.
QUICK_CHECK_DAILY_CAP=60

# Live market / analyst aggregate data (server only)
FMP_API_KEY=
# Free end-of-day fallback; protected by Supabase cache and 24-request daily cap.
# ALPHAVANTAGE_API_KEY and the legacy ALPHA_VENTAGE_API_KEY spelling are also accepted.
ALPHA_VANTAGE_API_KEY=

# Optional options-chain provider
MASSIVE_API_KEY=

# Persistence (server-side). SUPABASE_URL / SUPABASE_SECRET_KEY take precedence
# over the NEXT_PUBLIC_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY names below.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SEC asks API clients to identify themselves.
SEC_USER_AGENT=Equity Research Lab your-email@example.com

# Optional personal portfolio reader. Keep both values server-only.
# The route is manual and read-only; it is disabled unless SNAPTRADE_PORTAL_ENABLED=true.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_PORTAL_ENABLED=false
# Required for /accounts and /api/snaptrade: owner sign-in key (server-only, 32+ chars).
# Generate with: openssl rand -base64 32. Unset or short keys keep account refresh disabled.
OWNER_ACCESS_KEY=
